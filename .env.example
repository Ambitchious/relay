# ---- LLM provider -------------------------------------------------------
# One of: fake | groq | openai | anthropic
# "fake" is the default and needs no key — the agent runs with a scripted
# provider so you can exercise the loop offline.
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# ---- Slack --------------------------------------------------------------
# From api.slack.com/apps -> Basic Information -> Signing Secret
SLACK_SIGNING_SECRET=
# From OAuth & Permissions -> Bot User OAuth Token (needs chat:write, app_mentions:read)
SLACK_BOT_TOKEN=

# ---- Langfuse (optional) ------------------------------------------------
# cloud.langfuse.com -> Project Settings -> API Keys. Free tier is enough.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Agent --------------------------------------------------------------
MAX_TOOL_ITERATIONS=4
REQUEST_TIMEOUT_S=30
